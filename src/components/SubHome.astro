---
// VuePress SubHome.vue와 같은 마크업 (scoped 스타일 해시 data-v-5b3a16de 재사용)
// 목록은 무한 스크롤: 처음 perPage개만 보이고, 바닥에 닿으면 perPage개씩 더 보여줌
import { url, type Post } from "../lib/posts";
const { posts, title, desc } = Astro.props as { posts: Post[]; title: string; desc: string };
const perPage = 10;
---
<div data-v-5b3a16de class="subhome-list" data-per-page={perPage}>
  <div class="subhome" data-v-5b3a16de><h1 data-v-5b3a16de>{title}</h1> <p data-v-5b3a16de>{desc}</p></div>
  {posts.map((p, i) => (
    <div data-v-5b3a16de class="subhome-item" style={i >= perPage ? "display:none" : ""}>
      <div class="container" data-v-5b3a16de>
        <a href={url(p)} class="thumbnail-container" data-v-5b3a16de>
          <img src={p.data.image || "/logo.jpg"} loading="lazy" class="thumbnail" data-v-5b3a16de referrerpolicy="no-referrer" />
        </a>
        <div class="blog-content" data-v-5b3a16de>
          <h5 data-v-5b3a16de>{p.data.lastUpdated}</h5>
          <h3 data-v-5b3a16de><a href={url(p)} data-v-5b3a16de>{p.data.title}</a></h3>
          <p data-v-5b3a16de>{p.data.subTitle}</p>
        </div>
      </div>
      <h2 data-v-5b3a16de></h2>
    </div>
  ))}
  {posts.length > perPage && <div class="subhome-sentinel" aria-hidden="true"></div>}
</div>
<script>
  const list = document.querySelector<HTMLElement>(".subhome-list");
  const sentinel = list?.querySelector<HTMLElement>(".subhome-sentinel");
  if (list && sentinel) {
    const per = Number(list.dataset.perPage) || 10;
    const hidden = () => [...list.querySelectorAll<HTMLElement>(".subhome-item")].filter((el) => el.style.display === "none");
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      const rest = hidden();
      rest.slice(0, per).forEach((el) => (el.style.display = ""));
      if (rest.length <= per) { io.disconnect(); sentinel.remove(); return; }
      // 화면이 커서 센티널이 계속 보이면 다시 감지되도록 재등록
      io.unobserve(sentinel); io.observe(sentinel);
    }, { rootMargin: "600px 0px" });
    io.observe(sentinel);
  }
</script>
<style>
  .subhome-sentinel { height: 1px; }
</style>
