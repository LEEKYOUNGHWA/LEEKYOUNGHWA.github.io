---
import "../styles/global.css";
import ThemeControls from "../components/ThemeControls.vue";

interface Props { title?: string; description?: string; image?: string }
const { title, description = "경화의 생각과 기록", image } = Astro.props;
const fullTitle = title ? `${title} | MIND UPLOAD` : "MIND UPLOAD";
const ogImage = new URL(image ?? "/logo.jpg", Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: "/journal", label: "Journal" },
  { href: "/archive", label: "Archive" },
  { href: "/tags", label: "Tags" },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/logo.jpg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 깜빡임 없이 저장된 테마/색상 적용
      try {
        const t = localStorage.getItem("theme") ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = t;
        const a = localStorage.getItem("accent");
        if (a) document.documentElement.style.setProperty("--accent", a);
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand">
          <img src="/logo.jpg" alt="" width="32" height="32" />
          <span>MIND UPLOAD</span>
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class:list={{ active: path.startsWith(n.href) }}>{n.label}</a>
          ))}
        </nav>
        <ThemeControls client:load />
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Kyounghwa Lee</span>
        <a href="https://github.com/LEEKYOUNGHWA" target="_blank" rel="noopener">GitHub ↗</a>
      </div>
    </footer>
    <script>
      // ```mermaid 코드블록을 다이어그램으로
      const blocks = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
      if (blocks.length) {
        const { default: mermaid } = await import("mermaid");
        const dark = document.documentElement.dataset.theme === "dark";
        mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral" });
        blocks.forEach((pre) => {
          pre.classList.add("mermaid");
          pre.textContent = pre.textContent;
        });
        await mermaid.run({ nodes: [...blocks] });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: 20px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; letter-spacing: 0.04em; font-size: 15px; }
  .brand img { border-radius: 8px; object-fit: cover; }
  nav { display: flex; gap: 4px; margin-left: auto; }
  nav a { padding: 6px 12px; border-radius: 8px; color: var(--ink-2); font-size: 15px; font-weight: 500; }
  nav a:hover { color: var(--ink); background: var(--surface-2); }
  nav a.active { color: var(--accent); }
  main { min-height: 70vh; }
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; padding: 28px 0; color: var(--ink-3); font-size: 14px; }
  .site-footer .wrap { display: flex; justify-content: space-between; }
  @media (max-width: 640px) {
    .brand span { display: none; }
    .bar { gap: 8px; }
    nav a { padding: 6px 8px; font-size: 14px; }
  }
</style>
