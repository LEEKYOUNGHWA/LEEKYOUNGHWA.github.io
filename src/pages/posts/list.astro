---
import Layout from "../../layouts/Layout.astro";
import SubHome from "../../components/SubHome.astro";
import { listOf } from "../../lib/posts";
// TIL + Study + Journal 통합 (모두 posts/연도 폴더), 최근 수정순
const posts = await listOf("posts");
---
<Layout title="Home > posts">
  <div class="theme-default-content content__default">
    <SubHome posts={posts} title="Posts" desc="TIL · Study · Journal" />
  </div>
</Layout>
